# Скопируйте в .env и при необходимости отредактируйте.
# Все параметры опциональны — значения ниже совпадают с дефолтами modules/config.py.

# --- LLM ---------------------------------------------------------------------
APP_LLM_BACKEND=mlx
APP_MLX_MODEL=mlx-community/Qwen3-4B-Instruct-2507-4bit
# APP_OPENROUTER_MODEL=qwen/qwen3-30b-a3b-instruct-2507
# OPENROUTER_API_KEY=your_key          # обязателен при APP_LLM_BACKEND=openrouter

# --- Поведение агента --------------------------------------------------------
APP_MIN_RESEARCH_ITERATIONS=1
APP_MAX_RESEARCH_ITERATIONS=3
APP_ARXIV_MAX_CANDIDATES=5

# --- Хранилище и логи --------------------------------------------------------
APP_CACHE_DB_PATH=data/arxiv_cache.sqlite
APP_SUMMARIZATION_LOG_DIR=logs/summarizations

# --- Транспорт ---------------------------------------------------------------
APP_GRPC_HOST=localhost
APP_GRPC_PORT=50051

# --- LangSmith (опционально) -------------------------------------------------
APP_USE_HUB=false
# LANGSMITH_API_KEY=your_key
